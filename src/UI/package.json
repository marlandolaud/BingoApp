{
  "name": "bingo-ui",
  "private": true,
  "scripts": {
    "test": "node --test tests/unit/",
    "test:coverage": "c8 --check-coverage --lines 90 --branches 90 --functions 90 --statements 90 --include board.js --include api.js node --test tests/unit/",
    "test:e2e": "playwright test --project=e2e",
    "test:integration": "INTEGRATION=1 playwright test --project=integration",
    "test:mutation": "stryker run",
    "serve": "http-server -a 0.0.0.0 -p 8080 -c-1 .",
    "api": "DOTNET_ROLL_FORWARD=Major dotnet run --project ../BingoBongo/BingoBongo.csproj --launch-profile lan",
    "test:lan": "LAN=1 playwright test --project=integration lan.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^8.7.1",
    "c8": "^10.1.3",
    "http-server": "^14.1.1"
  }
}
